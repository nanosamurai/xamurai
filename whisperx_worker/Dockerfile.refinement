# syntax=docker/dockerfile:1

FROM python:3.13.17-slim-trixie@sha256:d98cc29d3266e535dd9da1099688d9cb3ca4753813571e071763d17725460962 AS dependencies

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

ENV PYTHONPATH=/app:/app/shared/src:/app/whisperx_worker/src

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY constraints.active-speech.txt /opt/constraints.active-speech.txt

RUN python -m venv /opt/venv \
    && pip install --upgrade -c /opt/constraints.active-speech.txt pip==26.2.2 setuptools wheel

# 1) Torch from the PyTorch CUDA index
# WhisperX pins torch~=2.8.0, so we align with that.
RUN pip install --no-deps \
      "torch==2.8.0+cu128" \
      "torchaudio==2.8.0+cu128" \
      --index-url https://download.pytorch.org/whl/cu128

# 2) Resolve Torch's dependencies and WhisperX packages from PyPI.
# The CUDA index is used only for the two explicitly selected Torch wheels.
RUN pip install -c /opt/constraints.active-speech.txt \
      numpy \
      scipy \
      soundfile \
      confluent-kafka \
      protobuf \
      boto3 \
      whisperx==3.8.6 \
      pyannote-audio==4.0.7 \
      opentelemetry-api \
      opentelemetry-sdk \
      opentelemetry-exporter-otlp \
    && pip check

FROM dependencies AS runtime

RUN /opt/venv/bin/python -m pip uninstall -y pip wheel \
    && /usr/local/bin/python -m pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.13/ensurepip

COPY proto_gen /app/proto_gen
COPY shared/src /app/shared/src
COPY whisperx_worker/src /app/whisperx_worker/src

RUN useradd -m -u 10001 appuser \
    && mkdir -p /data/hf_cache /data/recordings \
    && chown -R 10001:10001 /app /data
USER 10001

# Env vars:
# - KAFKA_BOOTSTRAP, KAFKA_TOPIC_AUDIO, KAFKA_TOPIC_REFINED
# - WHISPERX_SLICE_SECONDS, WHISPERX_IDLE_SECONDS, WHISPERX_COMPUTE_TYPE
# - KAFKA_GROUP_ID
CMD ["python", "-m", "whisperx_worker.refinement"]
