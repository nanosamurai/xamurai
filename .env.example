# Copy to .env and fill in as needed.

# Required by rtservice (pyannote model downloads)
HF_TOKEN=

# Optional: local paths to sibling repos (defaults work for your machine layout)
# Use forward slashes or escaped backslashes on Windows.
SAMURAIBFF_PATH=../../IdeaProjects/samuraibff
SAMURAIPERSISTOR_PATH=../../IdeaProjects/samuraipersistor

# BFF auth toggles (local compose defaults to disabled)
SAMURAIBFF_AUTH_REQUIRED=false
# Use the shared dev Keycloak running in ECS by default.
SAMURAIBFF_AUTH_ISSUER=https://auth.nanosamur.ai/realms/nanosamurai
